# ==============================================================================
# Git Ignore Configuration for ShipXpress (Logistic and Dispatch)
# ==============================================================================

# Maven build directories (Docker builds fresh on Render)
target/
**/target/
*.jar
*.war

# Node.js dependencies & build outputs (Vite builds fresh on Render)
node_modules/
**/node_modules/
dist/
**/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor configurations
.vscode/
.idea/
*.iml
*.suo
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db

# Environment & Secrets (Never commit secrets to GitHub)
.env
.env.*
*.env
!.env.example

# Logs & scratch files
*.log
**/stdout.log
**/stderr.log
